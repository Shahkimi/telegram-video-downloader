# =====================================================================
# Telegram Downloader Configuration Template
# Copy this file to '.env' (optional; the app will also prompt interactively)
# =====================================================================

# Telegram API Credentials (Get from https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Default Channel / Group ID or Username (Optional)
CHANNEL_ID=

# Maximum download size budget in bytes (Default: 20 GB = 21474836480 bytes)
MAX_TOTAL_SIZE=21474836480

# Downloads Directory
DOWNLOADS_DIR=
