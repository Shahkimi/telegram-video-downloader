# =====================================================================
# Telegram Downloader Configuration Template
# Copy this file to '.env' (optional; the app will also prompt interactively)
# =====================================================================

# Telegram API Credentials (Get from https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Default Channel / Group ID or Username (Optional)
CHANNEL_ID=

# Maximum download size budget in bytes (Default: 20 GB = 21474836480 bytes)
MAX_TOTAL_SIZE=21474836480

# Downloads Directory
DOWNLOADS_DIR=

# ---------------------------------------------------------------------
# Optional tuning (all of these can also be changed in menu 6: Settings)
# ---------------------------------------------------------------------

# How many files download at the same time
MAX_CONCURRENT_FILES=3

# Parallel connections per file (8-16 is fast; lower it if Telegram throttles you)
PARALLEL_CONNECTIONS=16

# Largest range accepted from a link such as t.me/channel/10-5000
RANGE_CAP=1000

# Videos from other websites (YouTube, TikTok, X, ...) through yt-dlp
YTDLP_ENABLED=1
# Biggest video height to fetch; 0 means the best available
YTDLP_MAX_HEIGHT=1080
# Optional cookies.txt exported from your browser (needed for some Instagram/X videos)
YTDLP_COOKIES=
